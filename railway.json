{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm turbo run build --filter=@tubi/api..."
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @tubi/api run db:deploy",
    "startCommand": "pnpm --filter @tubi/api run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
