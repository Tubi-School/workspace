# --- TUBI Workspace ----------------------------------------------------------
# Repository-level defaults. Each application also has its own `.env.example`:
#
#   apps/api/.env.example   NestJS service
#   apps/web/.env.example   Next.js client
#
# Copy the per-app files to `.env` (api) and `.env.local` (web). Nothing here
# is loaded automatically; this file documents the variables the workspace
# expects to exist somewhere.

# Consumed by the Prisma CLI when run from the repository root, and by the
# local PostgreSQL container defined in docker-compose.yml.
DATABASE_URL=postgresql://tubi:tubi@localhost:5432/tubi_workspace?schema=public
