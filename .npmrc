# Fail fast when the local Node/pnpm version does not satisfy `engines`.
engine-strict=true

# The stack deliberately mixes ecosystems with slightly different peer ranges
# (e.g. typescript-eslint has not yet widened its range to TypeScript 7).
# We pin exact versions ourselves, so a peer mismatch should warn, not abort.
strict-peer-dependencies=false

# Keep the store deterministic across CI runners.
prefer-workspace-packages=true
resolution-mode=highest
