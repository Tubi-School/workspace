// TUBI Workspace — database schema.
//
// Phase 2A domain design frozen for external architecture review at
// docs/phase-2a-final-domain-design.txt. Phase 2B implements that design at
// the database level. Do not redesign, simplify, or reinterpret any model,
// relation, enum, constraint or nullability below without reopening that
// document through architecture review.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API is a CommonJS NestJS process. Without these, Prisma 7 emits an
  // ESM-only client that uses `import.meta.url` and cannot be required.
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 no longer accepts `url` here. The connection string is supplied
  // by `prisma.config.ts` for the CLI, and by a driver adapter at runtime.
}

// ---------------------------------------------------------------------------
// Enums (docs/phase-2a-final-domain-design.txt, section D)
// ---------------------------------------------------------------------------

enum RoleName {
  ADMIN
  TEACHER
  LEARNER
}

enum DeliveryMode {
  LIVE_AND_RECORDED
  RECORDED_ONLY
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum TeacherRole {
  PRIMARY
  ASSISTANT
  SUBSTITUTE
}

enum CompletionMode {
  LIVE
  RECORDED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ExceptionReason {
  RECORDING_PROCESSING_DELAY
  PLATFORM_OUTAGE
  LEARNER_CIRCUMSTANCE
  OTHER
}

// ---------------------------------------------------------------------------
// Phase 4 — School Launch Core (docs/phase-4-school-launch-core-review.txt)
// ---------------------------------------------------------------------------

enum MeetingProvisioningStatus {
  NOT_REQUIRED
  PENDING
  PROVISIONED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum NotificationStatus {
  PENDING
  // Claimed by one dispatcher instance and currently being sent — the CAS
  // state that stops two Railway instances from sending the same item
  // twice (Phase 4 external review Correction 4B).
  SENDING
  SENT
  FAILED
}

// Phase 4 external review Correction 1: distinguishes an event TUBI has
// received from one it has actually finished applying, so a crash between
// the two can never leave the event permanently unprocessable nor cause a
// provider retry to silently skip work that never happened.
enum WebhookEventStatus {
  RECEIVED
  // Claimed by one in-flight processing attempt — see
  // WebhookIdempotencyService for the stale-reclaim window this unblocks.
  PROCESSING
  PROCESSED
}

// ---------------------------------------------------------------------------
// Identity (section B)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         RoleName
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  learnerProfile LearnerProfile?
  teacherProfile TeacherProfile?
}

model LearnerProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  dateOfBirth     DateTime?
  guardianContact String?
  createdAt       DateTime  @default(now())

  attendanceRecords       AttendanceRecord[]
  watchedIntervals        WatchedInterval[]
  liveAttendanceIntervals LiveAttendanceInterval[]
  subscriptionAccess      SubscriptionAccess[]
  entitlementSnapshots    SessionEntitlementSnapshot[]
  windowExceptions        AttendanceWindowException[]
  liveParticipantSessions LiveParticipantSession[]
  paymentOrders           PaymentOrder[]
}

model TeacherProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  bio       String?
  createdAt DateTime @default(now())

  primaryCourses  Course[]         @relation("CoursePrimaryTeacher")
  sessionTeaching SessionTeacher[]
}

// ---------------------------------------------------------------------------
// Curriculum taxonomy (section B — GradeLevel/AcademicTerm are first-class
// per founder rulings 1 and 2)
// ---------------------------------------------------------------------------

model GradeLevel {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model Subject {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model AcademicTerm {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  timezone  String   @default("Africa/Johannesburg")
  courses   Course[]
}

model Course {
  id               String         @id @default(uuid())
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id])
  gradeLevelId     String
  gradeLevel       GradeLevel     @relation(fields: [gradeLevelId], references: [id])
  academicTermId   String
  academicTerm     AcademicTerm   @relation(fields: [academicTermId], references: [id])
  primaryTeacherId String
  primaryTeacher   TeacherProfile @relation("CoursePrimaryTeacher", fields: [primaryTeacherId], references: [id])
  title            String

  sessions  Session[]
  offerings OfferingCourse[]
}

// ---------------------------------------------------------------------------
// Commercial layer (section B — Offering is the sellable unit; subscriptions
// are never per-lesson, per founder ruling 10)
// ---------------------------------------------------------------------------

model Offering {
  id           String       @id @default(uuid())
  name         String
  deliveryMode DeliveryMode
  monthlyPrice Decimal

  courses       OfferingCourse[]
  subscriptions SubscriptionAccess[]
  paymentOrders PaymentOrder[]
}

model OfferingCourse {
  offeringId String
  courseId   String
  offering   Offering @relation(fields: [offeringId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])

  @@id([offeringId, courseId])
}

// ---------------------------------------------------------------------------
// Session — the atomic teaching event (sections B, F, J)
// ---------------------------------------------------------------------------

model Session {
  id                 String        @id @default(uuid())
  courseId           String
  course             Course        @relation(fields: [courseId], references: [id])
  sessionDate        DateTime      @db.Date
  startTime          DateTime
  endTime            DateTime
  attendanceCutoffAt DateTime
  liveMeetingUrl     String
  status             SessionStatus @default(SCHEDULED)
  // Set the moment a session enters CANCELED, regardless of how far from its
  // scheduled start that occurs. Together with startTime this defines the
  // session's entitlement point as MIN(startTime, canceledAt) — founder
  // ruling / correction 2, section I.
  canceledAt         DateTime?

  // Phase 4 — automated live-classroom provisioning (section E). Populated
  // by MeetingProvisioningService, never typed in by an ADMIN in normal
  // production operation. `liveMeetingUrl` above continues to be the single
  // field every existing read path (learner/teacher portals) already
  // redacts/exposes; provisioning only ever writes into it.
  meetingProvider               String?
  providerMeetingId             String?                   @unique
  meetingProvisioningStatus     MeetingProvisioningStatus @default(NOT_REQUIRED)
  meetingProvisioningError      String?
  // Set the moment a caller atomically claims the right to provision (the
  // conditional-update CAS in MeetingProvisioningService) — lets a later
  // caller distinguish "someone is actively provisioning this right now"
  // from "a provisioning attempt crashed and this claim is stale" (Phase 4
  // external review Correction 3).
  meetingProvisioningClaimedAt  DateTime?
  // A fresh random value generated on every successful provisioning claim
  // (Phase 4 external review Correction 3 — fencing). Persisting a final
  // PROVISIONED/FAILED result is itself conditional on this token still
  // matching — a caller that lost its claim (reclaimed after the stale
  // window, or the session was canceled) can never finalize a meeting
  // onto this session; see MeetingProvisioningService.
  meetingProvisioningClaimToken String?
  reminderSentAt                DateTime?

  // A canceled session has at most one replacement (founder ruling 4,
  // section J). The replacement chain is unbounded via repeated
  // cancel-and-replace, but each individual session has exactly one
  // predecessor and at most one successor.
  replacementForSessionId String?  @unique
  replacementForSession   Session? @relation("SessionReplacement", fields: [replacementForSessionId], references: [id])
  replacementSession      Session? @relation("SessionReplacement")

  teachers                SessionTeacher[]
  recording               SessionRecording?
  attendanceRecords       AttendanceRecord[]
  windowExceptions        AttendanceWindowException[]
  entitlementSnapshots    SessionEntitlementSnapshot[]
  liveAttendanceIntervals LiveAttendanceInterval[]
  liveParticipantSessions LiveParticipantSession[]

  @@index([courseId, sessionDate])
}

model SessionTeacher {
  sessionId   String
  teacherId   String
  teacherRole TeacherRole
  session     Session        @relation(fields: [sessionId], references: [id])
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])

  // Exactly-one-PRIMARY-per-session is an application-layer invariant only
  // (founder ruling 15) — no partial unique index is introduced here.
  @@id([sessionId, teacherId])
}

// ---------------------------------------------------------------------------
// Recorded pathway (sections B, H1 — genuine 100% timeline coverage)
// ---------------------------------------------------------------------------

model SessionRecording {
  id                  String   @id @default(uuid())
  sessionId           String   @unique
  session             Session  @relation(fields: [sessionId], references: [id])
  // A provider playback URL (e.g. Zoom's `share_url`) when ingested
  // automatically — never a raw provider download URL carrying an
  // embedded access token (section M). Manually published recordings
  // (no configured provider) continue to store whatever URL an ADMIN
  // supplies, unchanged from Phase 2F/2G.
  recordingUrl        String
  availableFrom       DateTime
  totalSeconds        Int
  provider            String?
  providerRecordingId String?  @unique

  watchedIntervals WatchedInterval[]
}

model WatchedInterval {
  id                 String           @id @default(uuid())
  sessionRecordingId String
  recording          SessionRecording @relation(fields: [sessionRecordingId], references: [id])
  learnerId          String
  learner            LearnerProfile   @relation(fields: [learnerId], references: [id])
  startSecond        Int
  endSecond          Int

  // Rows are merged/coalesced on write by the service layer; coverage is
  // sum(endSecond - startSecond) across rows, compared against
  // SessionRecording.totalSeconds. Never a row per second.
  @@index([sessionRecordingId, learnerId])
}

// ---------------------------------------------------------------------------
// Live pathway (sections B, H2 — cumulative 50%-of-scheduled-duration
// coverage, founder ruling / correction 4)
// ---------------------------------------------------------------------------

model LiveAttendanceInterval {
  id        String         @id @default(uuid())
  sessionId String
  session   Session        @relation(fields: [sessionId], references: [id])
  learnerId String
  learner   LearnerProfile @relation(fields: [learnerId], references: [id])
  joinedAt  DateTime
  // Null while the connection is currently open.
  leftAt    DateTime?

  // Rows are merged/coalesced on write by the service layer; coverage is the
  // sum of clipped, merged durations within [session.startTime,
  // session.endTime], compared against 50% of scheduled duration. Never a
  // single "joined" boolean and never a row per heartbeat.
  @@index([sessionId, learnerId])
}

// ---------------------------------------------------------------------------
// Attendance (sections B, G — nullable completionMode/completedAt per
// founder ruling / correction 1)
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id        String         @id @default(uuid())
  sessionId String
  session   Session        @relation(fields: [sessionId], references: [id])
  learnerId String
  learner   LearnerProfile @relation(fields: [learnerId], references: [id])

  // Nullable: populated together only when status transitions to PRESENT.
  // Both remain null for PENDING and ABSENT — no invented completion mode
  // or timestamp is ever assigned to a learner who did not complete the
  // session (founder ruling / correction 1).
  completionMode CompletionMode?
  completedAt    DateTime?
  status         AttendanceStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  overrides AttendanceOverride[]

  @@unique([sessionId, learnerId])
  @@index([status])
}

model AttendanceOverride {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  previousStatus     AttendanceStatus
  newStatus          AttendanceStatus
  performedByUserId  String
  reason             String
  createdAt          DateTime         @default(now())
}

model AttendanceWindowException {
  id        String          @id @default(uuid())
  sessionId String
  session   Session         @relation(fields: [sessionId], references: [id])
  // Null = session-wide exception; set = learner-specific exception. A
  // learner-specific exception takes precedence over a session-wide one for
  // that learner when both exist (founder ruling / correction 4/18).
  learnerId String?
  learner   LearnerProfile? @relation(fields: [learnerId], references: [id])

  reason           ExceptionReason
  extendedCutoffAt DateTime
  grantedByUserId  String
  note             String?
  createdAt        DateTime        @default(now())

  @@index([sessionId, learnerId])
}

// ---------------------------------------------------------------------------
// Entitlement (sections B, I, J — entitlement point is
// MIN(session.startTime, session.canceledAt); inheritance chains are
// unbounded and non-unique per founder rulings / corrections 2 and 3)
// ---------------------------------------------------------------------------

model SessionEntitlementSnapshot {
  id        String         @id @default(uuid())
  sessionId String
  session   Session        @relation(fields: [sessionId], references: [id])
  learnerId String
  learner   LearnerProfile @relation(fields: [learnerId], references: [id])

  subscriptionAccessId String?
  subscriptionAccess   SubscriptionAccess? @relation(fields: [subscriptionAccessId], references: [id])
  wasEntitled          Boolean
  // Equal to the session's entitlement point:
  // MIN(session.startTime, session.canceledAt).
  snapshotAt           DateTime            @default(now())

  // Ordinary indexed self-reference — deliberately NOT unique, so that
  // replacement chains of arbitrary length (Original -> Replacement A ->
  // Replacement B -> ...) remain fully traceable (founder ruling /
  // correction 3).
  inheritedFromSnapshotId String?
  inheritedFromSnapshot   SessionEntitlementSnapshot?  @relation("EntitlementInheritance", fields: [inheritedFromSnapshotId], references: [id])
  inheritedBySnapshots    SessionEntitlementSnapshot[] @relation("EntitlementInheritance")

  @@unique([sessionId, learnerId])
  @@index([inheritedFromSnapshotId])
}

model SubscriptionAccess {
  id                 String             @id @default(uuid())
  learnerId          String
  learner            LearnerProfile     @relation(fields: [learnerId], references: [id])
  offeringId         String
  offering           Offering           @relation(fields: [offeringId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  entitlementSnapshots SessionEntitlementSnapshot[]
  paymentOrder         PaymentOrder?

  @@index([learnerId, offeringId])
}

// ---------------------------------------------------------------------------
// Phase 4 — live classroom provider integration (section D/H)
// ---------------------------------------------------------------------------

/**
 * Tracks an in-progress (not-yet-departed) provider participant connection
 * between a `participant_joined` and `participant_left` webhook event.
 * Deliberately NOT the attendance record itself — LiveAttendanceInterval
 * (frozen Phase 2F model, unchanged) remains the only source of qualifying
 * coverage; a row here is consumed and deleted the moment the matching
 * `participant_left` event ingests a completed interval, so it can never
 * accumulate unbounded history.
 */
model LiveParticipantSession {
  id                    String         @id @default(uuid())
  sessionId             String
  session               Session        @relation(fields: [sessionId], references: [id])
  learnerId             String
  learner               LearnerProfile @relation(fields: [learnerId], references: [id])
  providerParticipantId String
  joinedAt              DateTime

  // A duplicate/replayed `participant_joined` event for the same provider
  // participant connection must not open a second concurrent "in progress"
  // row (section I — duplicate/replayed provider events must not double
  // count).
  @@unique([sessionId, providerParticipantId])
}

/**
 * Webhook idempotency/audit ledger shared by every provider this school
 * integrates with (Zoom today; a payment provider below). One row per
 * externally-delivered event — never per retry — so a redelivered webhook
 * is recognised and safely no-op'd rather than re-applied.
 */
model ProviderWebhookEvent {
  id              String             @id @default(uuid())
  provider        String
  externalEventId String
  eventType       String
  status          WebhookEventStatus @default(RECEIVED)
  receivedAt      DateTime           @default(now())
  // Set (and refreshed) whenever a caller wins the PROCESSING claim.
  // WebhookIdempotencyService reclaims a PROCESSING row whose claimedAt is
  // older than its stale-processing window — the honest, bounded crash
  // recovery this design offers (see the service's doc comment for the
  // exact window and what it means in practice).
  claimedAt       DateTime?
  // A fresh random value generated on every successful claim (Phase 4
  // external review Correction 2 — fencing). `markProcessed`/`markFailed`
  // only take effect when the caller supplies the token it was actually
  // handed by `claim()`; a stale worker whose claim was reclaimed by
  // another worker after the stale window supplies a now-stale token and
  // is a safe no-op, never able to overwrite the newer worker's state.
  claimToken      String?
  processedAt     DateTime?

  @@unique([provider, externalEventId])
}

// ---------------------------------------------------------------------------
// Phase 4 — commercial/payment layer (section K). Deliberately upstream of
// SubscriptionAccess: a PaymentOrder never becomes a payment ledger and
// SubscriptionAccess is never contaminated with payment internals — the two
// meet only at the single point where a confirmed PaymentOrder is allowed
// to create exactly one SubscriptionAccess grant (section L).
// ---------------------------------------------------------------------------

model PaymentOrder {
  id                String         @id @default(uuid())
  learnerId         String
  learner           LearnerProfile @relation(fields: [learnerId], references: [id])
  offeringId        String
  offering          Offering       @relation(fields: [offeringId], references: [id])
  provider          String
  // Null until the provider assigns one at checkout initialization.
  providerReference String?        @unique
  // Integer minor units (cents) — never a floating-point amount (section
  // O). ZAR is the only currency this launch supports.
  amountMinor       Int
  currency          String         @default("ZAR")
  status            PaymentStatus  @default(PENDING)

  // Set exactly once, only by the verified-webhook path, only when status
  // transitions to PAID (section L). The unique constraint is the
  // database-level guarantee that a PaymentOrder can never be the origin
  // of more than one SubscriptionAccess grant, however many times its
  // webhook is redelivered.
  subscriptionAccessId String?             @unique
  subscriptionAccess   SubscriptionAccess? @relation(fields: [subscriptionAccessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learnerId])
}

// ---------------------------------------------------------------------------
// Phase 4 — essential notifications (section N). A lightweight durable
// outbox, not an event-sourcing platform: one row per notification to send,
// picked up and retried by NotificationDispatchService until SENT or
// permanently FAILED.
// ---------------------------------------------------------------------------

model NotificationOutboxItem {
  id              String             @id @default(uuid())
  type            String
  recipientUserId String
  payload         Json
  status          NotificationStatus @default(PENDING)
  attempts        Int                @default(0)
  createdAt       DateTime           @default(now())
  // Set (and refreshed) whenever a dispatcher instance wins the SENDING
  // claim — lets a stale claim (the instance that took it crashed before
  // marking SENT/PENDING again) be safely reclaimed by another tick after
  // NotificationDispatchScheduler's stale-processing window (Phase 4
  // external review Correction 4B).
  claimedAt       DateTime?
  // A fresh random value generated on every successful SENDING claim
  // (Phase 4 external review Correction 4 — fencing). The final
  // SENT/PENDING/FAILED write is conditional on this token still
  // matching — a dispatcher whose lease was reclaimed by another instance
  // after the stale window can never overwrite that instance's outcome.
  claimToken      String?
  sentAt          DateTime?
  lastError       String?

  @@index([status])
}
