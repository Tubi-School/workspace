# --- TUBI Workspace API ------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.

# development | test | production
NODE_ENV=development

# Port the HTTP server binds to. Railway injects this automatically.
PORT=3001

# PostgreSQL connection string.
# Local (see docker-compose.yml at the repository root):
DATABASE_URL=postgresql://tubi:tubi@localhost:5432/tubi_workspace?schema=public
# Neon (production) looks like:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/tubi_workspace?sslmode=require

# Comma-separated list of origins allowed to call this API from a browser.
# Include the deployed Vercel frontend and any custom production domain
# alongside local development — no code change is needed to add or remove
# an origin, only this variable.
CORS_ORIGINS=http://localhost:3000,https://tubi-workspace.vercel.app

# Reported by the health endpoints. Railway exposes the deployed commit SHA.
APP_VERSION=0.1.0

# Signing secret for authentication JWTs. Required, at least 32 characters.
# Generate one locally with: openssl rand -base64 48
# Never commit the real value — this file only documents the shape.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# How long an issued access token remains valid. Passed to `jsonwebtoken`.
JWT_EXPIRES_IN=1d

# --- Not environment-configurable by design (Phase 2G) -----------------------
# The following are conventional, hardcoded engineering choices rather than
# environment variables, since none of them change founder-defined semantics
# and none need to differ between environments:
#   - Attendance finalizer schedule: every 5 minutes (see
#     attendance/attendance-finalizer.scheduler.ts).
#   - Login rate limit: 5 attempts/minute per client, global default
#     100 requests/minute (see auth/auth.controller.ts, app.module.ts).
#   - Academic timezone: Africa/Johannesburg, frozen by founder ruling (see
#     sessions/academic-timezone.util.ts) — not configurable per environment.
# In production, Railway injects PORT and (if using Railway Postgres)
# DATABASE_URL automatically; this file documents their shape for local
# development only.
