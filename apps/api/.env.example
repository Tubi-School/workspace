# --- TUBI Workspace API ------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.

# development | test | production
NODE_ENV=development

# Port the HTTP server binds to. Railway injects this automatically.
PORT=3001

# PostgreSQL connection string used by the running application at runtime.
# Local (see docker-compose.yml at the repository root):
DATABASE_URL=postgresql://tubi:tubi@localhost:5432/tubi_workspace?schema=public
# Neon (production) looks like — this is the POOLED (-pooler) host:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/tubi_workspace?sslmode=require

# Optional. Connection string the Prisma CLI uses for `migrate deploy`/
# `migrate dev`/`studio` only — never read by the running application.
# Required in production (Railway): `prisma migrate deploy`'s session-scoped
# advisory lock can hang indefinitely against a pooled (PgBouncer) connection,
# so migrations must run against Neon's DIRECT (non "-pooler") host instead.
# When unset, the Prisma CLI falls back to DATABASE_URL — fine for local
# Postgres/CI where no pooler is involved.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/tubi_workspace?sslmode=require

# Comma-separated list of origins allowed to call this API from a browser.
# Include the deployed Vercel frontend and any custom production domain
# alongside local development — no code change is needed to add or remove
# an origin, only this variable.
CORS_ORIGINS=http://localhost:3000,https://tubi-workspace.vercel.app

# Reported by the health endpoints. Railway exposes the deployed commit SHA.
APP_VERSION=0.1.0

# Signing secret for authentication JWTs. Required, at least 32 characters.
# Generate one locally with: openssl rand -base64 48
# Never commit the real value — this file only documents the shape.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# How long an issued access token remains valid. Passed to `jsonwebtoken`.
JWT_EXPIRES_IN=1d

# --- Phase 4: Zoom (live classroom provider) --------------------------------
# All optional. Missing credentials put meeting provisioning and the Zoom
# webhook endpoint into an explicit "unconfigured" state rather than
# fabricating provider behavior. Outside production, an unconfigured Zoom
# integration falls back to a deterministic local-development fake meeting
# so the rest of the school can still be exercised.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Verifies the x-zm-signature header on inbound webhooks at /webhooks/zoom.
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Phase 4: payment provider (commercial layer) ---------------------------
# Paystack — the conventional choice for a South African ZAR launch. Optional
# — absent, checkout initialization returns a clear "payments not configured"
# error rather than faking a successful payment.
PAYSTACK_SECRET_KEY=
# Where Paystack redirects the learner after checkout.
PAYMENTS_CALLBACK_URL=https://tubi-workspace.vercel.app/learner/subscription

# --- Phase 4: essential notifications (email) -------------------------------
# Optional SMTP transport for NotificationDispatchScheduler. Missing
# configuration leaves every enqueued notification visible as FAILED with a
# readable reason — it never blocks the school-domain operation that
# enqueued it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@tubi.school

# Minutes before a session's scheduled start that its reminder is sent.
SESSION_REMINDER_LOOKAHEAD_MINUTES=60

# --- Not environment-configurable by design (Phase 2G) -----------------------
# The following are conventional, hardcoded engineering choices rather than
# environment variables, since none of them change founder-defined semantics
# and none need to differ between environments:
#   - Attendance finalizer schedule: every 5 minutes (see
#     attendance/attendance-finalizer.scheduler.ts).
#   - Login rate limit: 5 attempts/minute per client, global default
#     100 requests/minute (see auth/auth.controller.ts, app.module.ts).
#   - Academic timezone: Africa/Johannesburg, frozen by founder ruling (see
#     sessions/academic-timezone.util.ts) — not configurable per environment.
# In production, Railway injects PORT and (if using Railway Postgres)
# DATABASE_URL automatically; this file documents their shape for local
# development only.
